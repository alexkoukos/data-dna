# Copy to .env (cp .env.example .env). Never commit .env.
# Optional. Without it, clean prompts go to the local model (or a stub in tests).
OPENAI_API_KEY=
DB_USER=dna
DB_PASSWORD=change-me
DB_NAME=dna
LITELLM_MASTER_KEY=sk-admin-change-me
LOCAL_LLM_MODEL=gemma3:1b
EMBED_MODEL=intfloat/multilingual-e5-small
RETENTION_DAYS=30
DEMO_MODE=true
# X27 browser extension: its ID from chrome://extensions after loading extension/ (see README).
EXTENSION_ID=
# Split storage vaults (two separate Postgres instances). Change for anything but a demo.
VAULT_A_USER=vault_a
VAULT_A_ADMIN_USER=vault_a_admin
VAULT_A_ADMIN_PASSWORD=change-me-a-admin
VAULT_A_PASSWORD=change-me-a
VAULT_B_USER=vault_b
VAULT_B_ADMIN_USER=vault_b_admin
VAULT_B_ADMIN_PASSWORD=change-me-b-admin
VAULT_B_PASSWORD=change-me-b
# Bearer token for the /v1/vault/* HTTP routes (store, reveal, aggregate). Empty = routes are off.
# Create one with: openssl rand -hex 32
VAULT_API_TOKEN=
# X30 SIEM export (all optional, off when empty). For the demo receiver: SIEM_SYSLOG_HOST=syslog-receiver
SIEM_SYSLOG_HOST=
SIEM_SYSLOG_PORT=514
SIEM_SYSLOG_PROTO=udp
SIEM_WEBHOOK_URL=
SIEM_WEBHOOK_SECRET=
SIEM_EXPORT_TOKEN=
