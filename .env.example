# Copy to .env (cp .env.example .env). Never commit .env.
# Optional. Without it, clean prompts go to the local model (or a stub in tests).
OPENAI_API_KEY=
DB_USER=dna
DB_PASSWORD=change-me
DB_NAME=dna
LITELLM_MASTER_KEY=sk-admin-change-me
LOCAL_LLM_MODEL=gemma3:1b
EMBED_MODEL=intfloat/multilingual-e5-small
RETENTION_DAYS=30
DEMO_MODE=true
# X27 browser extension: its ID from chrome://extensions after loading extension/ (see README).
EXTENSION_ID=
# Split storage vaults (two separate Postgres instances). Change for anything but a demo.
VAULT_A_USER=vault_a
VAULT_A_ADMIN_USER=vault_a_admin
VAULT_A_ADMIN_PASSWORD=change-me-a-admin
VAULT_A_PASSWORD=change-me-a
VAULT_B_USER=vault_b
VAULT_B_ADMIN_USER=vault_b_admin
VAULT_B_ADMIN_PASSWORD=change-me-b-admin
VAULT_B_PASSWORD=change-me-b
# Bearer token for the /v1/vault/* HTTP routes (store, reveal, aggregate). Empty = routes are off.
# Create one with: openssl rand -hex 32
VAULT_API_TOKEN=
# X30 SIEM export (all optional, off when empty). For the demo receiver: SIEM_SYSLOG_HOST=syslog-receiver
SIEM_SYSLOG_HOST=
SIEM_SYSLOG_PORT=514
SIEM_SYSLOG_PROTO=udp
SIEM_WEBHOOK_URL=
SIEM_WEBHOOK_SECRET=
SIEM_EXPORT_TOKEN=

# Optional settings. The defaults below match docker-compose.yml, so you can leave them as they are.

# Send an alert to this URL when an incident happens (empty = off)
ALERT_WEBHOOK_URL=

# Limits per personal key (0 = no limit)
KEY_RPM_LIMIT=0
KEY_MAX_BUDGET=0

# Links shown in warnings and alerts
COMPANY_AI_URL=http://localhost:3000/chat
WEB_URL=http://localhost:3000

# Files attached in Company Chat: size per file (bytes), files per message, characters of each
# file passed to the model (the rest is cut and the chat says so), seconds to read one file.
# The web server takes at most 12 MB per request (web/nginx.conf), so keep FILE_MAX_BYTES below it.
FILE_MAX_BYTES=10485760
FILE_MAX_COUNT=3
FILE_MAX_CHARS=30000
FILE_EXTRACT_TIMEOUT=60

# Fill the demo database with synthetic data on first start
SEED_ON_START=true

# Optional: path to your own key file for the split store (empty = the app makes one itself)
HMAC_KEY_FILE=

